# Copy to .env.local for local overrides, or set these in your host's environment.
# Nothing is required for `npm run dev`; everything marked "production" must be set for `next start`.

# Database (production). postgres://user:password@host:5432/naijamentors
# Leave unset in development to use the embedded database stored in ./data/pglite.
# DATABASE_URL=postgres://localhost:5432/naijamentors
# DATABASE_POOL_MAX=10

# Signs session cookies (production). At least 32 random characters:  openssl rand -base64 48
# SESSION_SECRET=

# Public address of the site, used for links in emails (production).
# APP_URL=https://naijamentors.com

# Shown on the guide, the session room and the footer, and in every email.
# SAFEGUARDING_EMAIL=safeguarding@naijamentors.com

# Email. Without RESEND_API_KEY, emails are printed to the server console instead of sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Naija Mentors <hello@naijamentors.com>"
# EMAIL_REPLY_TO=support@naijamentors.com

# Protects /api/cron/message-digest (production).  openssl rand -hex 32
# CRON_SECRET=
